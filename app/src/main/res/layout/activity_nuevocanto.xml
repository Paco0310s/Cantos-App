<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg_color"
    android:fitsSystemWindows="true"
    tools:context=".ui.NuevoCantoActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Encabezado de la Tarjeta -->
                    <TextView
                        android:id="@+id/tvHeaderCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información del Canto"
                        android:textColor="@color/card_title_color"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Completa los datos, letra con acordes y su clasificación"
                        android:textColor="@color/text_secondary_color"
                        android:textSize="13sp" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        app:dividerColor="@color/card_stroke_color" />

                    <!-- Campos principales -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RoundedOutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nombre"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/card_title_color" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/RoundedOutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="Autor / Compositor"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAutor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:textColor="@color/card_title_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="Tono / Clave"
                            app:boxBackgroundColor="@color/input_fill_color"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/input_box_stroke_color"
                            app:boxStrokeWidth="1.5dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:endIconTint="@color/input_box_stroke_color"
                            app:hintTextColor="@color/text_secondary_color"
                            app:startIconTint="@color/input_box_stroke_color">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etTono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/card_title_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RoundedOutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/letra"
                        app:helperText="💡 Tip: Encierra los acordes entre comillas simples (ej. 'DO') para resaltarlos."
                        app:helperTextTextColor="@color/tag_momento_text_color">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLetra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="8"
                            android:textColor="@color/card_title_color" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Sección Clasificación -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Clasificación Litúrgica"
                        android:textColor="@color/text_secondary_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bMomento"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:onClick="mostrarMomentos"
                            android:text="@string/momento"
                            android:textAllCaps="false"
                            android:textColor="@color/tag_momento_text_color"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tag_momento_bg_color"
                            app:cornerRadius="14dp"
                            app:elevation="0dp"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bTiempo"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:onClick="mostrarTiempos"
                            android:text="@string/tiempo"
                            android:textAllCaps="false"
                            android:textColor="@color/tag_tiempo_text_color"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tag_tiempo_bg_color"
                            app:cornerRadius="14dp"
                            app:elevation="0dp"
                            app:strokeWidth="0dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMomentosSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/tag_momento_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Momentos: Entrada, Comunión"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvTiemposSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tag_tiempo_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Tiempos: Cuaresma"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bAgregar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:backgroundTint="@color/primary_button_bg"
                        android:onClick="agregarCanto"
                        android:text="@string/guardar"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_button_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
