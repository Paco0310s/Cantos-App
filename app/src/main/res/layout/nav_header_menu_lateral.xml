<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/screen_bg_color"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civPhotoUser"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@string/nav_header_desc"
        android:src="@drawable/ic_usuario"
        app:civ_border_color="@color/tag_momento_text_color"
        app:civ_border_width="2dp" />

    <TextView
        android:id="@+id/tvUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/card_title_color"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Paco Sotelo" />

    <TextView
        android:id="@+id/tvEmailUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary_color"
        android:textSize="13sp"
        tools:text="paco@example.com" />

    <TextView
        android:id="@+id/tvGrupoActivoNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tag_tiempo_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/tag_tiempo_text_color"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Grupo: Coro San José"
        tools:visibility="visible" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:dividerColor="@color/card_stroke_color" />

</LinearLayout>
